{
  "name": "babylon-hikari-street",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hikari Street rebuilt in Babylon.js",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 5180",
    "test": "node --test scripts/side-missions.test.mjs scripts/save-system.test.mjs",
    "android": "cap sync android",
    "android:apk": "cap sync android && cd android && gradlew assembleDebug",
    "test:exploration": "node scripts/exploration-check.mjs",
    "perf": "node scripts/perf-check.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.29.0",
    "@babylonjs/materials": "^9.29.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "kokoro-js": "^1.2.1",
    "meshoptimizer": "^1.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@gltf-transform/cli": "^4.5.1",
    "playwright-core": "^1.63.0",
    "vite": "^6.4.4"
  }
}
